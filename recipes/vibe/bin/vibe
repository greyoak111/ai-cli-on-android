#!{{PREFIX}}/bin/bash
# vibe — Mistral Vibe（cccodroid 组件 · 启动器型）
#
#   和官方一样的用法：vibe / vibe -p "…" / vibe --help
#
# 组件不含厂商二进制：首次运行从官方 GitHub Releases 取（sha256 已钉死）。
#
# 环境变量：
#   CCODROID_AI_CLI_HOME   安装根目录（默认 ~/.local/share/cccodroid/ai-cli）
set -e

PREFIX="${CCODROID_PREFIX:-${PREFIX:-}}"
[ -n "$PREFIX" ] || PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

HOME_DIR="${HOME:-$PREFIX/../home}"
ROOT="${CCODROID_AI_CLI_HOME:-$HOME_DIR/.local/share/cccodroid/ai-cli}/vibe"
DATA="$PREFIX/share/cccodroid/components/vibe"
APP="$ROOT/app"

if [ ! -x "$APP/vibe" ]; then
  echo "vibe: 首次运行，从官方 Releases 取独立二进制（约 74 MB，只这一次）" >&2
  mkdir -p "$ROOT"
  "$PREFIX/bin/python3" "$DATA/fetch.py" "$DATA/vibe.json" "$ROOT" >&2
fi

LIBS="$ROOT/libs"
# PyInstaller 的 onedir 程序会二次启动自己，那一刻命令行上的 --library-path 不在，
# 只会搜自己的 _internal/ —— 缺的库要再放一份进去
if [ -f "$LIBS/libz.so.1" ] && [ ! -e "$APP/_internal/libz.so.1" ]; then
  cp "$LIBS/libz.so.1" "$APP/_internal/libz.so.1" 2>/dev/null || true
fi

LD="$PREFIX/glibc/lib/ld-linux-aarch64.so.1"
SHIM="$(dirname "${CCAPP_BIN:-$PREFIX/../app/bin}")/lib/seccomp-enosys.so"
[ -x "$LD" ] || { echo "vibe: 缺 glibc 加载器：$LD" >&2; exit 2; }

unset LD_PRELOAD
if [ -r "$SHIM" ]; then
  exec "$LD" --library-path "$LIBS:$PREFIX/glibc/lib" --argv0 "$APP/vibe" \
    --preload "$SHIM" "$APP/vibe" "$@"
else
  exec "$LD" --library-path "$LIBS:$PREFIX/glibc/lib" --argv0 "$APP/vibe" "$APP/vibe" "$@"
fi
