#!{{PREFIX}}/bin/bash
# codebuddy — CodeBuddy Code（cccodroid 组件 · 启动器型）
#
#   和官方一样的用法：codebuddy / codebuddy -p "…" / codebuddy --help
#
# 组件本身不含任何厂商文件：首次运行从官方 npm 装到用户私有目录，之后直接复用。
#
# 环境变量：
#   CCODROID_AI_CLI_HOME          安装根目录（默认 ~/.local/share/cccodroid/ai-cli）
#   CCODROID_CODEBUDDY_VERSION    覆盖配方钉住的版本
set -e

PREFIX="${CCODROID_PREFIX:-${PREFIX:-}}"
[ -n "$PREFIX" ] || PREFIX="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

PKG="@tencent-ai/codebuddy-code"
VER="${CCODROID_CODEBUDDY_VERSION:-2.167.0}"
HOME_DIR="${HOME:-$PREFIX/../home}"
ROOT="${CCODROID_AI_CLI_HOME:-$HOME_DIR/.local/share/cccodroid/ai-cli}/codebuddy-code"
BIN="$ROOT/node_modules/.bin/codebuddy"

if [ ! -x "$BIN" ]; then
  echo "codebuddy: 首次运行，从官方 npm 装 $PKG@$VER（只有这一次，装在 $ROOT）" >&2
  mkdir -p "$ROOT"
  # --os=linux --cpu=arm64：见 recipes/README.md（安卓上 npm 的平台匹配）
  "$PREFIX/bin/npm" install --prefix "$ROOT" --no-audit --no-fund \
    --os=linux --cpu=arm64 "$PKG@$VER" >&2
fi

exec "$BIN" "$@"
